  - fireInspectionPassed : boolean
  + Runway(id : String, name : String, lengthMeters : int, deicingReady : boolean)
  + getLengthMeters() : int
  + isDeicingReady() : boolean
  + setFireInspectionPassed(passed : boolean) : void
  + getId() : String
  + getName() : String
  + getStatusSummary() : String
  + accept(visitor : AirportVisitor) : void
}

class Terminal <<ConcreteElement>> {
  - id : String
  - name : String
  - areaSqMeters : int
  - gatesCount : int
  - fireInspectionPassed : boolean
  + Terminal(id : String, name : String, areaSqMeters : int, gatesCount : int)
  + getAreaSqMeters() : int
  + getGatesCount() : int
  + setFireInspectionPassed(passed : boolean) : void
  + getId() : String
  + getName() : String
  + getStatusSummary() : String
  + accept(visitor : AirportVisitor) : void
}

class JetBridge <<ConcreteElement>> {
  - id : String
  - name : String
  - cyclesCompleted : int
  - fireInspectionPassed : boolean
  + JetBridge(id : String, name : String, cyclesCompleted : int)
  + getCyclesCompleted() : int
  + setFireInspectionPassed(passed : boolean) : void
  + getId() : String
  + getName() : String
  + getStatusSummary() : String
  + accept(visitor : AirportVisitor) : void
}

class FuelStorage <<ConcreteElement>> {
  - id : String
  - name : String
