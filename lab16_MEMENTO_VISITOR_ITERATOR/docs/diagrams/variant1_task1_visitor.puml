}

interface AirportVisitor <<Visitor>> {
  + visitRunway(runway : Runway) : void
  + visitTerminal(terminal : Terminal) : void
  + visitJetBridge(jetBridge : JetBridge) : void
  + visitFuelStorage(fuelStorage : FuelStorage) : void
}

class MaintenanceCostVisitor <<ConcreteVisitor>> {
  - totalCost : double
  + getTotalCost() : double
  + visitRunway(runway : Runway) : void
  + visitTerminal(terminal : Terminal) : void
  + visitJetBridge(jetBridge : JetBridge) : void
  + visitFuelStorage(fuelStorage : FuelStorage) : void
}

class FireSafetyVisitor <<ConcreteVisitor>> {
  - checkedCount : int
  + getCheckedCount() : int
  + visitRunway(runway : Runway) : void
  + visitTerminal(terminal : Terminal) : void
  + visitJetBridge(jetBridge : JetBridge) : void
  + visitFuelStorage(fuelStorage : FuelStorage) : void
}

class AviationAuthorityReportVisitor <<ConcreteVisitor>> {
  - reportLines : List<String>
  + getReportLines() : List<String>
  + visitRunway(runway : Runway) : void
  + visitTerminal(terminal : Terminal) : void
  + visitJetBridge(jetBridge : JetBridge) : void
  + visitFuelStorage(fuelStorage : FuelStorage) : void
}

class AirportInfrastructure <<ObjectStructure>> {
  - airportName : String
  - objects : List<InfrastructureObject>
  + AirportInfrastructure(airportName : String)
  + addObject(obj : InfrastructureObject) : void
  + applyVisitor(visitor : AirportVisitor) : void
  + logState(stageLabel : String) : void
}

class Main <<Client>> {
  + {static} runVariant1Task1() : void
  + {static} main(args : String[]) : void
}

