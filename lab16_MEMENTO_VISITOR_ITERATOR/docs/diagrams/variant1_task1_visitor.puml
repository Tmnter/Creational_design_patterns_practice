  - currentLiters : double
  - fireInspectionPassed : boolean
  + FuelStorage(id : String, name : String, capacityLiters : double, currentLiters : double)
  + getCapacityLiters() : double
  + getCurrentLiters() : double
  + setFireInspectionPassed(passed : boolean) : void
  + getId() : String
